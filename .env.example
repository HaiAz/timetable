# Firebase — sao chép sang .env.local rồi điền giá trị từ Firebase Console.
# Các biến NEXT_PUBLIC_* được nhúng vào bundle trình duyệt: đây KHÔNG phải bí mật.
# Bảo vệ dữ liệu nằm ở Firestore security rules, không phải ở các khoá này.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Cổng mật mã — CHỈ tồn tại trên máy chủ (không có tiền tố NEXT_PUBLIC_).
# Bỏ trống APP_PASSCODE thì tắt cổng, vào thẳng không cần xác thực.
APP_PASSCODE=
# Khoá ký cookie. Đổi giá trị này thì mọi phiên đã đăng nhập bị đăng xuất.
# Sinh khoá mới: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
