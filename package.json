{
  "name": "timetable",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "firebase emulators:exec --project timetable-test --only firestore \"vitest run\"",
    "test:watch": "firebase emulators:exec --project timetable-test --only firestore \"vitest\"",
    "test:no-emulator": "vitest run",
    "emulators": "firebase emulators:start --project timetable-test --only firestore"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^14.27.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
